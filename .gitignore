.venv/
__pycache__/
*.pyc

# training artifacts (not source)
# The globs also catch checkpoint directories kept aside under a suffix when
# a retrain supersedes one, which are just as large.
training_checkpoints*/
cyclegan_checkpoints*/
samples/
cyclegan_samples/
logs/
application/output/

# downloaded datasets
datasets/

# large local datasets (baked into the Docker image separately, not committed)
preprocess/images/
preprocess/outdata/

# local tooling state
.claude/
.DS_Store

# cluster credentials - never commit
aws-cluster.conf
*.pem
*.kubeconfig
kubeconfig
